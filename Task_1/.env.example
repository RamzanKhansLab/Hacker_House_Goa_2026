# Server
PORT=8787
NODE_ENV=development
CLIENT_URL=http://localhost:5173
# Used to construct public OG and share URLs in production.
PUBLIC_SERVER_URL=http://localhost:8787

# Optional. The share API uses short-lived in-memory metadata during local
# development when MongoDB is not configured.
MONGODB_URI=
SHARE_TTL_HOURS=24
SHARE_STORAGE_DIRECTORY=generated

# Client (place this in client/.env for a separately deployed frontend)
VITE_API_BASE_URL=http://localhost:8787
