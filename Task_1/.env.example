# Local development (explicit local-only storage)
PORT=8787
NODE_ENV=development
CLIENT_URL=http://localhost:5173
PUBLIC_SERVER_URL=http://localhost:8787
MONGODB_URI=
SHARE_TTL_HOURS=24
STORAGE_PROVIDER=local
SHARE_STORAGE_DIRECTORY=generated

# Cloudflare R2 -- required when STORAGE_PROVIDER=r2 (production)
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=
# A public custom domain, for example: https://images.example.com
R2_PUBLIC_BASE_URL=
# Optional. If empty, the server derives https://<R2_ACCOUNT_ID>.r2.cloudflarestorage.com
R2_ENDPOINT=

# Client only (place this in client/.env for a separately deployed frontend)
VITE_API_BASE_URL=http://localhost:8787
